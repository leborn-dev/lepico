<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if meta.title %}{{ meta.title }} | {% endif %}{{ site_title }}</title>
    {% if meta.description %}<meta name="description" content="{{ meta.description }}">{% endif %}
    {% if meta.robots %}<meta name="robots" content="{{ meta.robots }}">{% endif %}
</head>
<body>
    <header><a href="{{ base_url }}">{{ site_title }}</a></header>
    <nav aria-label="Main navigation">
        <ul>
        {% for page in pages(depthOffset=-1) %}
            {% if not page.hidden %}
            <li><a href="{{ page.url }}">{{ page.title ?: page.id }}</a></li>
            {% endif %}
        {% endfor %}
        </ul>
    </nav>
    <main>{{ content }}</main>
</body>
</html>
